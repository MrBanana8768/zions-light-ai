# Copy this to lab/v4/.env.lab and fill in real values. .env.lab is
# gitignored -- passwords never go in git. v4lab-up.sh creates it for you
# with random passwords if it doesn't exist yet.

# Test user passwords (registration is closed; these are used by
# scripts/v4lab-create-users.sh with the admin CLI, and by the bot).
LAB_HER_PASSWORD=changeme
LAB_OWNER_PASSWORD=changeme
LAB_BOT_PASSWORD=changeme

# Synapse admin access token, captured by v4lab-create-users.sh after it
# creates @owner as an admin user. Used for the rate-limit override and by
# scripts/create_room.py.
LAB_ADMIN_TOKEN=

# Filled in by scripts/create_room.py after it creates her E2EE room and
# invites @bot:localhost. Restart the bot service after this changes.
LAB_HER_ROOM_ID=

# Where the copies of her data live. Never the read-only pod-export path.
LAB_DATA_DIR=/home/drew/scratch/v4lab/data

# The tiny CPU model. See LAB.md "The model" for why these two are kept in
# sync (one is the GGUF repo llama.cpp serves, the other is the original HF
# repo the compactor and the shim load a tokenizer from).
LAB_MODEL_GGUF_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
LAB_MODEL_GGUF_FILE=Q4_K_M
LAB_MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct
