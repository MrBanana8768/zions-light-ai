# Synapse logging config for the V4 lab — console (stdout) only, copied from
# chat-app's synapse/log.config. Logs go to `docker compose logs`, never to
# a file, so there is no risk of a log file accumulating her plaintext.
version: 1

formatters:
  precise:
    format: '%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s'

handlers:
  console:
    class: logging.StreamHandler
    formatter: precise

loggers:
  synapse.storage.SQL:
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
